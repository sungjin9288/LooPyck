{
  "name": "fashion-price-compare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "ntl:status": "npx netlify status",
    "ntl:login": "npx netlify login",
    "ntl:link": "npx netlify link --git-remote-url https://github.com/sungjin9288/LooPyck.git",
    "ntl:sync-env": "node scripts/syncNetlifyEnv.mjs",
    "ntl:smoke": "node scripts/netlifySmokeCheck.mjs",
    "ntl:admin-smoke": "node scripts/netlifyAdminSmoke.mjs",
    "ntl:browser-smoke": "bash scripts/netlifyBrowserSmoke.sh",
    "ntl:admin-browser-smoke": "bash scripts/netlifyAdminBrowserSmoke.sh",
    "ntl:deploy:preview": "NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app npx netlify deploy --build",
    "ntl:deploy:prod": "NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app npx netlify deploy --build --prod",
    "cf:sync-vars": "node scripts/syncCloudflareDevVars.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:sync-vars && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/checkEnv.ts",
    "lint": "npm run typecheck",
    "test:trends": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/monthlyTrendAnalyzer.test.mjs",
    "test:adapters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-specifier-resolution=node --test tests/marketplaceScrapers.test.ts tests/searchDiagnostics.test.ts tests/queryLearning.test.ts tests/pdpDiagnostics.test.ts tests/optionHistory.test.ts tests/variantHistory.test.ts tests/variantSelection.test.ts tests/favoriteProduct.test.ts tests/favoriteGrouping.test.ts tests/alertLinks.test.ts tests/alertDetail.test.ts tests/alertInbox.test.ts tests/alertState.test.ts tests/alertDiagnostics.test.ts tests/alertRecommendations.test.ts tests/alertPersonalization.test.ts tests/alertTuningStore.test.ts tests/productMatching.test.ts tests/purchasePricing.test.ts tests/sourceCommerceParsing.test.ts tests/variantAlignment.test.ts tests/pdpDetailEnrichment.test.ts tests/fashionQueryAssistant.test.ts tests/searchQualityRegression.test.ts tests/preferenceRerank.test.ts",
    "cap:doctor": "node scripts/capacitorDoctor.mjs",
    "cap:sync": "npx cap sync",
    "cap:sync:prod": "CAPACITOR_SERVER_URL=https://loo-pyck.netlify.app NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:ios:prod": "CAPACITOR_SERVER_URL=https://loo-pyck.netlify.app NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:android:prod": "CAPACITOR_SERVER_URL=https://loo-pyck.netlify.app NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "cap:build:prod": "NEXT_PUBLIC_SITE_URL=https://loo-pyck.netlify.app SITE_URL=https://loo-pyck.netlify.app CAPACITOR_SERVER_URL=https://loo-pyck.netlify.app npm run build && npm run cap:sync:prod",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor '#000000' --splashBackgroundColor '#000000'"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.0.7",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@toss/tds-mobile": "^2.3.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.33.0",
    "lenis": "^1.3.17",
    "next": "^16.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.73.0"
  }
}
