# 네이버 쇼핑 API 키
# https://developers.naver.com/apps/#/register 에서 발급받으세요
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# Firebase Web SDK (Project settings > General > Your apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# Admin dashboard access (comma-separated Firebase Auth UIDs)
NEXT_PUBLIC_ADMIN_UIDS=uid_1,uid_2

# Gemini API Key (AI features)
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key

# Firebase Admin SDK (server-side price history / alert scanner)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cron job protection secret for /api/jobs/scan-price-alerts
CRON_SECRET=your_strong_random_secret

# iOS Associated Domains (AASA)
IOS_TEAM_ID=YOUR_TEAM_ID
IOS_BUNDLE_ID=com.custom.loopyck
IOS_APPCLIP_BUNDLE_ID=com.custom.loopyck.Clip

# Distributed Rate Limit (Upstash Redis)
# https://upstash.com/ 에서 REST URL/TOKEN 확인
# 미설정 시 in-memory limiter로 자동 폴백됩니다.
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
RATE_LIMIT_PREFIX=loopyck:rl
