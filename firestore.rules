rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rule for Artifacts Storage
    match /artifacts/{appId} {
      
      // User specific data: Strict Ownership
      match /users/{userId}/favorites/{productId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // Global Product Statistics (Social Counters): Public Read, Authenticated Increment
      match /products/{productId} {
        allow read: if true; 
        allow write: if isAuthenticated(); // Broad write allowed for now to support client-side transaction
      }
    }
  }
}
